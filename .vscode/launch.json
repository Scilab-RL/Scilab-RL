{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "cppo_cc_ma",
            "type": "debugpy",
            "request": "launch",
            "program": "src/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": "+performance=MyoElbow/cleanppo_cc-opti",
            "env": {
                "MUJOCO_GL": "osmesa"
            }
        },
        {
            "name": "cppo",
            "type": "debugpy",
            "request": "launch",
            "program": "src/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": "algorithm=cleanppo env=FetchPush",
            "env": {
                "MUJOCO_GL": "osmesa"
            }
        },
        {
            "name": "cleanppo_cc",
            "type": "debugpy",
            "request": "launch",
            "program": "src/main.py",
            "console": "integratedTerminal",
            "args": "algorithm=cleanppo_cc",
            "env": {
                "MUJOCO_GL": "osmesa"
            }
        },
        {
            "name": "Python Debugger: Current File with Arguments and osmesa opengl",
